{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>KyoriPowered/.github:renovate-config"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 5pm on the 2nd day of the month"
    ],
    "groupName": "python dependencies"
  },
  "packageRules": [
    {
      "matchCategories": [
        "python"
      ],
      "groupName": "python dependencies"
    }
  ]
}
